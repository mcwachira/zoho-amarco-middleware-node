 - '0' - No 
 - '1' - Yes</Desc>
    </Res>
    <Res Name="SalesNumber" Value="" Type="Text" MaxLen="3">
      <Desc>3 symbols for number of sales</Desc>
    </Res>
    <Res Name="SubtotalAmountVATGA" Value="" Type="Decimal" MaxLen="13">
      <Desc>Up to 13 symbols for subtotal by VAT group A</Desc>
    </Res>
    <Res Name="SubtotalAmountVATGB" Value="" Type="Decimal" MaxLen="13">
      <Desc>Up to 13 symbols for subtotal by VAT group B</Desc>
    </Res>
    <Res Name="SubtotalAmountVATGC" Value="" Type="Decimal" MaxLen="13">
      <Desc>Up to 13 symbols for subtotal by VAT group C</Desc>
    </Res>
    <Res Name="SubtotalAmountVATGD" Value="" Type="Decimal" MaxLen="13">
      <Desc>Up to 13 symbols for subtotal by VAT group D</Desc>
    </Res>
    <Res Name="SubtotalAmountVATGE" Value="" Type="Decimal" MaxLen="13">
      <Desc>Up to 13 symbols for subtotal by VAT group E</Desc>
