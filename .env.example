NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info
DEPENDENCY_HEALTH_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=30000

DATABASE_PROVIDER=postgresql

POSTGRES_USER=zoho_amarco
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=zoho_amarco_dev

DATABASE_URL=postgresql://zoho_amarco:replace_with_a_local_password@localhost:5438/zoho_amarco_dev
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000


# Protect invoice/profile APIs with a random secret of at least 32 characters.
# INVOICE_API_BEARER_TOKEN=<secret>
# Privileged operator token is distinct; it can manage profiles and request device/eTIMS operations.
# OPERATOR_API_BEARER_TOKEN=<different-secret>
# Optional per-operator identity and least-privilege permissions. Configure this
# OR OPERATOR_API_BEARER_TOKEN, not both. Subjects become durable audit labels.
# Tokens must be unique and at least 32 characters.
# Zoho API routes also require invoice:read at their shared router boundary.
# OPERATOR_API_CREDENTIALS_JSON='[{"subject":"operator.alice","token":"replace-with-a-unique-secret-of-32-chars-minimum","permissions":["invoice:read","manual-review:decide","etims:reconcile"]}]'

# This configures read-only local diagnostics only; it does not enable issuance.
# Read-only diagnostics are disabled unless the adapter is explicitly selected.
# This selection does not enable fiscal receipt commands.
# TREMOL_ADAPTER=disabled
# TREMOL_TRANSPORT=http
# TREMOL_BASE_URL=http://127.0.0.1:4444
# TREMOL_TIMEOUT_MS=5000

# Optional until Zoho OAuth is configured.
# Replace these locally when ready; never commit real credentials.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=

ZOHO_REDIRECT_URI=http://localhost:3000/integrations/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Optional read-only Zoho Books inspection. Set ZOHO_LIVE_VERIFY=1 only for a deliberate run.
# This authorizes GET-only inspection of the configured invoice; it does not establish that
# the organization or invoice is non-production. Verify tenant and invoice safety separately.
# ZOHO_LIVE_VERIFY_DATABASE_URL=postgresql://.../zoho_amarco_zoho_live_test
# ZOHO_LIVE_TEST_INVOICE_ID=<existing Zoho Books invoice ID>
# ZOHO_ORGANIZATION_ID=123456789
# Required with Zoho client credentials; generate 32 random bytes encoded as 64 hex characters.
# ZOHO_OAUTH_ENCRYPTION_KEY=
# Optional. Enables an operator-only Zoho invoice custom-field writeback route.
# Use IDs created in the target Zoho Books organization; there are no built-in IDs.
# This setting does not enable fiscalization or any KRA/device operation.
# OAuth must be granted ZohoBooks.invoices.UPDATE (in addition to READ).
# ZOHO_FISCALIZATION_WRITEBACK_FIELDS_JSON={"statusFieldId":"<tenant-custom-field-id>","successStatusValue":"Fiscalized","deviceReceiptNumberFieldId":"<tenant-custom-field-id>","etimsReferenceFieldId":"<tenant-custom-field-id>","fiscalizedAtFieldId":"<tenant-custom-field-id>","requestIdFieldId":"<tenant-custom-field-id>"}

# Full-catalog invoice synchronization is disabled unless explicitly enabled.
# This scans all invoice pages; it does not use a modification-time checkpoint.
ZOHO_SYNC_ENABLED=false
ZOHO_SYNC_INTERVAL_MS=900000
ZOHO_SYNC_PAGE_SIZE=200
ZOHO_SYNC_MAX_PAGES=1000

# Stale operations are marked uncertain; they are never replayed automatically.
FISCALIZATION_RECOVERY_ENABLED=false
FISCALIZATION_RECOVERY_INTERVAL_MS=300000
FISCALIZATION_RECOVERY_STALE_AGE_MS=1800000
# Explicit local-only simulation; rejected in production. Simulation scenarios are deterministic.
FISCALIZATION_SIMULATION_ENABLED=false
FISCALIZATION_SIMULATED_DEVICE_SCENARIO=success
FISCALIZATION_SIMULATED_ETIMS_SCENARIO=accepted
FISCALIZATION_SIMULATED_SEQUENCE=device_then_etims

# eTIMS reporting is disabled by default. When explicitly enabled outside
# production, select one adapter and configure its matching settings below.
# Selection does not verify enrollment, contract, mappings, or operation.
ETIMS_REPORTING_ENABLED=false
ETIMS_RECONCILIATION_ENABLED=false
# Required when ETIMS_REPORTING_ENABLED=true or simulation is enabled. Supply either this single-key compatibility value or the keyring below via a secret manager.
# ETIMS_PAYLOAD_ENCRYPTION_KEY=<64-hex-character-key>
ETIMS_PAYLOAD_ENCRYPTION_KEY_ID=legacy-v1
# For rotation, provide the whole retained keyring from a secret manager and select its active key ID.
# ETIMS_PAYLOAD_ENCRYPTION_KEYRING_JSON={"legacy-v1":"<64-hex-key>","2026-rotate-1":"<64-hex-key>"}
ETIMS_PAYLOAD_ENCRYPTION_ACTIVE_KEY_ID=legacy-v1
# ETIMS_ADAPTER=vscu
# VSCU speaks to the locally installed official KRA VSCU JAR service. This URL
# configures diagnostics only; it does not start the JAR or enable submissions.
# ETIMS_VSCU_BASE_URL=http://127.0.0.1:8088
# OSCU environment must be selected explicitly; the client pins to KRA's official
# sandbox or production origin and never falls back between them.
# ETIMS_OSCU_ENVIRONMENT=sandbox
# ETIMS_PROVIDER_TIMEOUT_MS=15000
ETIMS_RECONCILIATION_INTERVAL_MS=300000
ETIMS_RECONCILIATION_BATCH_SIZE=10
ETIMS_RECONCILIATION_MAX_ATTEMPTS=5
ETIMS_RECONCILIATION_OPERATION_TIMEOUT_MS=15000
ETIMS_RECONCILIATION_MAX_RUNTIME_MS=120000
ETIMS_RECONCILIATION_STALE_AGE_MS=1800000
