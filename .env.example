NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_PROVIDER=postgresql

POSTGRES_USER=zoho_amarco
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=zoho_amarco_dev

DATABASE_URL=postgresql://zoho_amarco:replace_with_a_local_password@localhost:5438/zoho_amarco_dev

# Optional until Zoho OAuth is configured.
# Replace these locally when ready; never commit real credentials.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=

ZOHO_REDIRECT_URI=http://localhost:3000/integrations/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Full-catalog invoice synchronization is disabled unless explicitly enabled.
# This scans all invoice pages; it does not use a modification-time checkpoint.
ZOHO_SYNC_ENABLED=false
ZOHO_SYNC_INTERVAL_MS=900000

# eTIMS reporting is disabled by default. Adapter selection is explicit and
# does not verify enrollment, contract, mappings, or make an adapter operational.
ETIMS_REPORTING_ENABLED=false
# ETIMS_ADAPTER=vscu
