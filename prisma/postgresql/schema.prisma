generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma/postgresql"
}

datasource db {
  provider = "postgresql"
}

model FiscalizationRecord {
  id            String @id @default(cuid()) @db.VarChar(100)
  zohoInvoiceId String @unique @db.VarChar(255)
  status        String @default("Pending") @db.VarChar(32)

  receiptNumber String?   @db.VarChar(100)
  issuedAt      DateTime?

  failureCode    String? @db.VarChar(100)
  failureMessage String? @db.VarChar(2000)

  outcomeUnknownReason String? @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
